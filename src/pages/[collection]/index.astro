---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { articles, sections, sectionNames } from '../../lib/content';
export function getStaticPaths() {
  return sectionNames.map((collection) => ({ params: { collection }, props: { collection } }));
}
const { collection } = Astro.props;
const section = sections[collection];
const entries = await articles(collection);
---
<BaseLayout title={`${section.label} · ${section.title} — Hunt it down`} description={section.description}>
  <main class="wrap content-page" id="main">
    <header class="page-heading">
      <div class="eyebrow">{section.label} / {entries.length} 篇公开内容</div>
      <h1>{section.title}</h1>
      <p>{section.description}</p>
      <a class="text-link" href="/tags/">按标签浏览 ↗</a>
    </header>
    <ArticleList entries={entries} />
  </main>
</BaseLayout>
