---
import BaseLayout from './BaseLayout.astro';
import { sections, tagUrl, type Article } from '../lib/content';
interface Props { entry: Article; }
const { entry } = Astro.props;
const section = sections[entry.collection];
---
<BaseLayout title={`${entry.data.title} — Hunt it down`} description={entry.data.description}>
  <main class="wrap reading-page" id="main">
    <a class="text-link" href={`/${entry.collection}/`}>← 返回{section.title}</a>
    <article>
      <header class="article-header">
        <div class="eyebrow">{section.label} / {section.title}</div>
        <h1>{entry.data.title}</h1>
        {entry.collection !== 'projects' && <p class="article-intro">{entry.data.description}</p>}
        <div class="article-meta">
          {entry.data.date && <span>发布于 <time datetime={entry.data.date}>{entry.data.date}</time></span>}
          {entry.data.updated && <span>更新于 <time datetime={entry.data.updated}>{entry.data.updated}</time></span>}
          {entry.data.status && <span class="project-status">{entry.data.status}</span>}
        </div>
        {entry.data.tags.length > 0 && <div class="tag-list">{entry.data.tags.map((tag) => <a class="tag" href={tagUrl(tag)}>{tag}</a>)}</div>}
      </header>
      <div class="prose"><slot /></div>
    </article>
    <div class="article-end"><a class="text-link" href={`/${entry.collection}/`}>← 更多{section.title}</a><a class="text-link" href="/">回到首页 ↑</a></div>
  </main>
</BaseLayout>
