---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Hunt it down — Work, Notes & Curiosity',
  description = 'Hunt it down 的个人主页。记录软件工程、航空数据处理、系统原理，以及仍在探索中的问题。',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isNotFound = Astro.url.pathname === '/404/' || Astro.url.pathname === '/404.html';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1119" />
    <link rel="icon" type="image/jpeg" href="/images/avatar.jpg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳转到正文</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
